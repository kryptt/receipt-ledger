{
  "__inputs": [],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "receipt-ledger observability: dispositions, no-progress, review-rate, statement balance reconciliation, and run liveness. Metrics are LogQL recording rules (receiptledger:*, recorded from the structured JSON logs) plus kube-state-metrics. See docs/observability/README.md for the field contract and the recording/alert rules these panels mirror.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "row",
      "title": "Throughput & dispositions",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Dispositions by source over time",
      "description": "receiptledger:outcomes:rate5m broken out by source and disposition (booked / duplicate / skipped / review). The substrate for volume and the review-rate alert.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 1 },
      "id": 1,
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 15,
            "stacking": { "mode": "normal", "group": "A" },
            "axisPlacement": "auto"
          },
          "unit": "short",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (source, disposition) (receiptledger:outcomes:rate5m)",
          "legendFormat": "{{source}} / {{disposition}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Review rate (5m, all sources)",
      "description": "sum(receiptledger:outcomes:rate5m{disposition=\"review\"}). Alert ReceiptLedgerReviewPileup fires when this stays > 5 for 30m.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 2,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(receiptledger:outcomes:rate5m{disposition=\"review\"})",
          "legendFormat": "review/5m",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Liveness & no-progress",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Deferred on last run (no-progress)",
      "description": "receiptledger:deferred:last — messages left in INBOX on the last run-complete line. Co-primary ReceiptLedgerNoProgress fires when this is > 0 AND the last successful run is older than 3h.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "id": 3,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "receiptledger:deferred:last",
          "legendFormat": "deferred",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Time since last successful run",
      "description": "Age of kube_cronjob_status_last_successful_time{cronjob=\"receipt-ledger\"}. Persists across runs even when a hard abort emits no run-complete line. Turns red past the 3h no-progress window (hourly cron ⇒ healthy is well under 1h).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "id": 4,
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 7200 },
              { "color": "red", "value": 10800 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "time() - kube_cronjob_status_last_successful_time{cronjob=\"receipt-ledger\"}",
          "legendFormat": "age",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Failed jobs",
      "description": "kube_job_status_failed{job_name=~\"receipt-ledger.*\"}. Alert ReceiptLedgerRunFailing fires on > 0 (hard error / model-selection abort / panic → non-zero exit).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "id": 5,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(kube_job_status_failed{job_name=~\"receipt-ledger.*\"})",
          "legendFormat": "failed",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Statement correctness",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Statement closing-balance delta",
      "description": "receiptledger:balance_delta:last — the last checked statement's |computed − stated| closing balance. Correctness alert ReceiptLedgerBalanceMismatch fires when abs(delta) > 0.01. Only meaningful when balance_checked=true (the recording rule already filters to that).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 19 },
      "id": 6,
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 10,
            "pointSize": 6,
            "showPoints": "always",
            "thresholdsStyle": { "mode": "line" }
          },
          "unit": "none",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "abs(receiptledger:balance_delta:last)",
          "legendFormat": "abs(balance_delta)",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5m",
  "schemaVersion": 39,
  "tags": ["receipt-ledger", "observability"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "receipt-ledger — observability",
  "uid": "receipt-ledger-obs",
  "version": 1,
  "weekStart": ""
}
