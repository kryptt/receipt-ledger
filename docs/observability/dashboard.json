{
  "__inputs": [],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "datasource",
      "id": "loki",
      "name": "Loki",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "receipt-ledger observability: dispositions, no-progress, review-rate, statement balance reconciliation, and run liveness. The application signals are queried as LogQL directly against Loki (${loki}) — receipt-ledger is a one-shot CronJob with no scrape endpoint, and no receiptledger:* recording rules are materialised into Prometheus. Liveness comes from kube-state-metrics via ${datasource}. Note the JSON emitter nests structured fields under `fields`, so Loki's `| json` flattens them to `fields_*` — that prefix is load-bearing in every query here. See docs/observability/README.md for the field contract.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "row",
      "title": "Throughput & dispositions",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Dispositions by source over time",
      "description": "Rolling 5m count of `message outcome` log lines, broken out by source and disposition (booked / duplicate / skipped / review). The substrate for volume and the review-rate alert.",
      "datasource": { "type": "loki", "uid": "${loki}" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 1 },
      "id": 1,
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 15,
            "stacking": { "mode": "normal", "group": "A" },
            "axisPlacement": "auto"
          },
          "unit": "short",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${loki}" },
          "expr": "sum by (fields_source, fields_disposition) (count_over_time({namespace=\"home\", app=\"receipt-ledger\"} | json | fields_message=\"message outcome\" [5m]))",
          "legendFormat": "{{fields_source}} / {{fields_disposition}}",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Review count (1h, all sources)",
      "description": "Rolling 1h count of `message outcome` lines with disposition=review. Matches the deployed ReceiptLedgerReviewPileup alert, which fires above 10.",
      "datasource": { "type": "loki", "uid": "${loki}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 2,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${loki}" },
          "expr": "sum(count_over_time({namespace=\"home\", app=\"receipt-ledger\"} | json | fields_disposition=\"review\" [1h]))",
          "legendFormat": "review/1h",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Liveness & no-progress",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Deferred on last run (no-progress)",
      "description": "Messages left in INBOX on the last `run complete` line, over a 3h lookback (the cron is hourly, so 3h always covers at least one run). Pairs with ReceiptLedgerDeferredSustained (> 0 for 1h) and the panel to its right.",
      "datasource": { "type": "loki", "uid": "${loki}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "id": 3,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${loki}" },
          "expr": "max(last_over_time({namespace=\"home\", app=\"receipt-ledger\"} | json | __error__=\"\" | fields_message=\"run complete\" | unwrap fields_deferred [3h]))",
          "legendFormat": "deferred",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Time since last successful run",
      "description": "Age of kube_cronjob_status_last_successful_time{cronjob=\"receipt-ledger\"}. Persists across runs even when a hard abort emits no run-complete line. Turns red past the 3h no-progress window (hourly cron ⇒ healthy is well under 1h).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "id": 4,
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 7200 },
              { "color": "red", "value": 10800 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "time() - kube_cronjob_status_last_successful_time{cronjob=\"receipt-ledger\"}",
          "legendFormat": "age",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Failed jobs",
      "description": "kube_job_status_failed{job_name=~\"receipt-ledger.*\"}. Alert ReceiptLedgerRunFailing fires on > 0 (hard error / model-selection abort / panic → non-zero exit).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "id": 5,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(kube_job_status_failed{job_name=~\"receipt-ledger.*\"})",
          "legendFormat": "failed",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Statement correctness",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Statement closing-balance delta",
      "description": "The last checked statement's signed (computed − stated) closing-balance delta, filtered to balance_checked=true. Correctness alert ReceiptLedgerBalanceMismatch fires above 0.01. LogQL has no abs(), so this is the signed value — the alert is likewise one-sided. The 14d lookback matches Loki retention so a sparse signal (statements arrive roughly monthly) still renders a line instead of a gap; the plotted value is the last statement seen, not one per time bucket.",
      "datasource": { "type": "loki", "uid": "${loki}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 19 },
      "id": 6,
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 10,
            "pointSize": 6,
            "showPoints": "always",
            "thresholdsStyle": { "mode": "line" }
          },
          "unit": "none",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${loki}" },
          "expr": "max(last_over_time({namespace=\"home\", app=\"receipt-ledger\"} | json | __error__=\"\" | fields_balance_checked=\"true\" | unwrap fields_balance_delta [14d]))",
          "legendFormat": "balance_delta",
          "queryType": "range",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5m",
  "schemaVersion": 39,
  "tags": ["receipt-ledger", "observability"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      },
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Loki",
        "multi": false,
        "name": "loki",
        "options": [],
        "query": "loki",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "receipt-ledger — observability",
  "uid": "receipt-ledger-obs",
  "version": 1,
  "weekStart": ""
}
